<%- include('../partials/header') %>
<a class="small" href="/admin/ads">← My ads</a>
<h1 class="h3 page-title mt-2 mb-1">Comments</h1>
<p class="text-muted">Under your ad <a href="/item/<%= ad.id %>" target="_blank"><%= ad.title %></a>. Delete comments that are inappropriate.</p>

<% if (comments.length === 0) { %>
  <div class="alert alert-info">There are no comments under this ad yet.</div>
<% } else { %>
  <ul class="list-group shadow-sm">
    <% for (const c of comments) { %>
      <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
        <div>
          <div class="small text-muted">
            <strong><%= c.username %></strong> · <%= c.created_at %>
            <% if (c.is_blocked) { %><span class="badge text-bg-danger">blocked by admin</span><% } %>
          </div>
          <div style="white-space: pre-wrap;"><%= c.text %></div>
        </div>
        <form method="post" action="/admin/comments/<%= c.id %>/delete" onsubmit="return confirm('Delete this comment?')">
          <button class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
      </li>
    <% } %>
  </ul>
<% } %>
<%- include('../partials/footer') %>

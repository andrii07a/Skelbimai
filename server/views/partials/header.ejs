<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Classifieds admin</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <style>
    body { background: #f5f6f8; }
    .ad-thumb { width: 72px; height: 54px; object-fit: cover; border-radius: .375rem; background: #e9ecef; }
    .table td { vertical-align: middle; }
  </style>
</head>
<body>
<%
  const navLink = (href, label) =>
    `<li class="nav-item"><a class="nav-link${currentPath === href ? ' active' : ''}" href="${href}">${label}</a></li>`;
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/admin">Classifieds <span class="badge text-bg-warning">admin</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
            aria-controls="adminNav" aria-expanded="false" aria-label="Menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="adminNav">
      <% if (currentUser) { %>
        <ul class="navbar-nav me-auto">
          <%- navLink('/admin/ads', 'My ads') %>
          <%- navLink('/admin/ads/new', '+ New ad') %>
          <%- navLink('/admin/favorites', '⭐ Saved') %>
          <% if (currentUser.role === 'admin') { %>
            <li class="nav-item d-none d-lg-block"><span class="nav-link disabled">|</span></li>
            <%- navLink('/admin/categories', 'Categories') %>
            <%- navLink('/admin/users', 'Users') %>
            <%- navLink('/admin/moderation/ads', 'All ads') %>
            <%- navLink('/admin/moderation/comments', 'All comments') %>
          <% } %>
        </ul>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <a class="btn btn-sm btn-outline-light" href="/">Public site ↗</a>
          <span class="text-light small">
            <%= currentUser.username %>
            <% if (currentUser.role === 'admin') { %><span class="badge text-bg-warning">admin</span><% } %>
          </span>
          <form method="post" action="/admin/logout" class="m-0">
            <button class="btn btn-sm btn-light">Log out</button>
          </form>
        </div>
      <% } else { %>
        <ul class="navbar-nav me-auto"></ul>
        <a class="btn btn-sm btn-outline-light" href="/">Public site ↗</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="container pb-5">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

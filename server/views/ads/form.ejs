<%- include('../partials/header') %>
<%
  const invalid = (field) => errors[field] ? ' is-invalid' : '';
  const feedback = (field) => errors[field] ? `<div class="invalid-feedback">${errors[field]}</div>` : '';
  const action = ad ? `/admin/ads/${ad.id}` : '/admin/ads';
%>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h3 mb-3"><%= title %></h1>

    <% if (ad && ad.is_blocked) { %>
      <div class="alert alert-warning">This ad was blocked by the administrator and is hidden from the public site.</div>
    <% } %>
    <% if (Object.keys(errors).length > 0) { %>
      <div class="alert alert-danger">Please fix the errors below.</div>
    <% } %>

    <form class="card card-body shadow-sm" method="post" action="<%= action %>" enctype="multipart/form-data" novalidate>
      <div class="mb-3">
        <label class="form-label" for="title">Title</label>
        <input class="form-control<%= invalid('title') %>" id="title" name="title" maxlength="100"
               value="<%= values.title || '' %>" required>
        <%- feedback('title') %>
      </div>

      <div class="row">
        <div class="col-sm-7 mb-3">
          <label class="form-label" for="category_id">Category</label>
          <select class="form-select<%= invalid('category_id') %>" id="category_id" name="category_id" required>
            <option value="">— choose —</option>
            <% for (const c of categories) { %>
              <option value="<%= c.id %>" <%= String(values.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% } %>
          </select>
          <%- feedback('category_id') %>
        </div>
        <div class="col-sm-5 mb-3">
          <label class="form-label" for="price">Price, €</label>
          <input class="form-control<%= invalid('price') %>" id="price" name="price" inputmode="decimal"
                 value="<%= values.price ?? '' %>" placeholder="e.g. 25 or 19.99" required>
          <%- feedback('price') %>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <textarea class="form-control<%= invalid('description') %>" id="description" name="description" rows="6"
                  maxlength="3000" required><%= values.description || '' %></textarea>
        <%- feedback('description') %>
      </div>

      <div class="mb-3">
        <label class="form-label" for="image">Photo <%= ad ? '(leave empty to keep the current one)' : '' %></label>
        <% if (ad && ad.image) { %>
          <div class="mb-2"><img src="/uploads/<%= ad.image %>" alt="Current photo" class="rounded" style="max-height: 160px;"></div>
        <% } %>
        <input class="form-control<%= invalid('image') %>" id="image" name="image" type="file"
               accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" <%= ad ? '' : 'required' %>>
        <%- feedback('image') %>
        <div class="form-text">JPG, PNG, WEBP or GIF, up to <%= maxSizeMb %> MB.</div>
      </div>

      <div class="d-flex gap-2">
        <button class="btn btn-primary"><%= ad ? 'Save changes' : 'Publish ad' %></button>
        <a class="btn btn-outline-secondary" href="/admin/ads">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>

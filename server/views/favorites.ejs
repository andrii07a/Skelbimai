<%- include('partials/header') %>
<h1 class="h3 mb-1">⭐ Saved ads</h1>
<p class="text-muted">Ads you starred on the <a href="/">public site</a>.</p>

<% if (favorites.length === 0) { %>
  <div class="alert alert-info">You have not saved any ads yet. Click the ☆ star on the public site to save an ad.</div>
<% } else { %>
  <div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr><th>Photo</th><th>Title</th><th>Category</th><th>Seller</th><th class="text-end">Price</th><th></th></tr>
      </thead>
      <tbody>
        <% for (const ad of favorites) { %>
          <tr>
            <td><img class="ad-thumb" src="/uploads/<%= ad.image %>" alt=""></td>
            <td>
              <% if (ad.is_blocked || ad.owner_blocked) { %>
                <%= ad.title %> <span class="badge text-bg-secondary">no longer available</span>
              <% } else { %>
                <a href="/ads/<%= ad.id %>" target="_blank"><%= ad.title %></a>
              <% } %>
            </td>
            <td><%= ad.category_name %></td>
            <td><%= ad.owner %></td>
            <td class="text-end text-nowrap"><%= ad.price.toFixed(2) %> €</td>
            <td class="text-end">
              <form method="post" action="/admin/favorites/<%= ad.id %>/delete" class="m-0">
                <button class="btn btn-sm btn-outline-secondary">Remove</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('partials/footer') %>

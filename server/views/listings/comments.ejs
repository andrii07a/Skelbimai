<%- include('../partials/top') %>
<div class="mb-3">
  <a class="small" href="/admin/listings">← My listings</a>
  <h1 class="h3 page-title mt-1 mb-0">Comments</h1>
  <p class="text-muted mb-0">
    Under <a href="/item/<%= listing.id %>" target="_blank"><%= listing.title %></a>.
    Remove anything rude, spammy or off-topic.
  </p>
</div>

<% if (comments.length === 0) { %>
  <div class="card card-body text-center text-muted py-5">Nobody has commented on this listing yet.</div>
<% } else { %>
  <div class="comment-stack">
    <% for (const c of comments) { %>
      <div class="comment-row<%= c.blocked_at ? ' is-blocked' : '' %>">
        <span class="avatar avatar--small"><%= c.author.charAt(0).toUpperCase() %></span>
        <div class="flex-grow-1">
          <div class="small">
            <strong><%= c.author %></strong>
            <span class="text-muted">· <%= c.posted_at.slice(0, 16) %></span>
            <% if (c.blocked_at) { %><span class="status-pill status-pill--hidden ms-1">hidden by admin</span><% } %>
          </div>
          <div class="pre-wrap"><%= c.body %></div>
        </div>
        <form method="post" action="/admin/comments/<%= c.id %>/delete" onsubmit="return confirm('Remove this comment?')">
          <button class="btn btn-sm btn-outline-danger">Remove</button>
        </form>
      </div>
    <% } %>
  </div>
<% } %>
<%- include('../partials/bottom') %>

<%- include('partials/header') %>
<%
  const invalid = (field) => errors[field] ? ' is-invalid' : '';
  const feedback = (field) => errors[field] ? `<div class="invalid-feedback">${errors[field]}</div>` : '';
%>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3">Create an account</h1>
        <form method="post" action="/admin/register" novalidate>
          <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input class="form-control<%= invalid('username') %>" id="username" name="username"
                   value="<%= values.username || '' %>" required autofocus>
            <%- feedback('username') %>
          </div>
          <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <input class="form-control<%= invalid('email') %>" id="email" name="email" type="email"
                   value="<%= values.email || '' %>" required>
            <%- feedback('email') %>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input class="form-control<%= invalid('password') %>" id="password" name="password" type="password" required>
            <%- feedback('password') %>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password2">Repeat password</label>
            <input class="form-control<%= invalid('password2') %>" id="password2" name="password2" type="password" required>
            <%- feedback('password2') %>
          </div>
          <button class="btn btn-primary w-100">Register</button>
        </form>
        <p class="text-center small mt-3 mb-0">Already registered? <a href="/admin/login">Log in</a></p>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>

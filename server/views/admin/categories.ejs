<%- include('../partials/header') %>
<h1 class="h3 mb-3">Categories</h1>

<form class="card card-body shadow-sm mb-4" method="post" action="/admin/categories" novalidate>
  <label class="form-label" for="name">New category</label>
  <div class="input-group has-validation">
    <input class="form-control<%= error ? ' is-invalid' : '' %>" id="name" name="name" maxlength="50"
           value="<%= value %>" placeholder="e.g. Books" required>
    <button class="btn btn-primary">Create</button>
    <% if (error) { %><div class="invalid-feedback"><%= error %></div><% } %>
  </div>
</form>

<div class="table-responsive bg-white rounded shadow-sm">
  <table class="table mb-0">
    <thead class="table-light"><tr><th>Name</th><th class="text-end">Ads</th><th class="text-end">Actions</th></tr></thead>
    <tbody>
      <% for (const c of categories) { %>
        <tr>
          <td><%= c.name %></td>
          <td class="text-end"><%= c.ad_count %></td>
          <td class="text-end">
            <form method="post" action="/admin/categories/<%= c.id %>/delete" class="m-0"
                  onsubmit="return confirm('Delete category <%= c.name.replace(/'/g, '') %>?')">
              <button class="btn btn-sm btn-outline-danger" <%= c.ad_count > 0 ? 'disabled title="The category has ads"' : '' %>>Delete</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

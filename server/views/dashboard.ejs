<%- include('partials/header') %>
<div class="mb-4">
  <h1 class="h3 page-title mb-1">Hi, <%= currentUser.username %> 👋</h1>
  <p class="text-muted mb-0">Here is what is happening with your ads.</p>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-4">
    <a class="stat-card" href="/admin/ads">
      <div class="stat-number"><%= stats.myAds %></div>
      <div class="stat-label">ads posted by you</div>
    </a>
  </div>
  <div class="col-sm-6 col-xl-4">
    <a class="stat-card" href="/admin/ads">
      <div class="stat-number"><%= stats.myComments %></div>
      <div class="stat-label">questions under your ads</div>
    </a>
  </div>
  <div class="col-sm-6 col-xl-4">
    <a class="stat-card stat-card--accent" href="/admin/favorites">
      <div class="stat-number"><%= stats.favorites %></div>
      <div class="stat-label">★ ads you saved</div>
    </a>
  </div>
</div>

<% if (currentUser.role === 'admin') { %>
  <h2 class="h6 text-uppercase text-muted fw-bold mb-3" style="letter-spacing: .08em">Whole marketplace</h2>
  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
      <a class="stat-card stat-card--accent" href="/admin/users">
        <div class="stat-number"><%= stats.users %></div>
        <div class="stat-label">users</div>
      </a>
    </div>
    <div class="col-6 col-xl-3">
      <a class="stat-card stat-card--accent" href="/admin/categories">
        <div class="stat-number"><%= stats.categories %></div>
        <div class="stat-label">categories</div>
      </a>
    </div>
    <div class="col-6 col-xl-3">
      <a class="stat-card stat-card--accent" href="/admin/moderation/ads">
        <div class="stat-number"><%= stats.allAds %></div>
        <div class="stat-label">ads in total</div>
      </a>
    </div>
    <div class="col-6 col-xl-3">
      <a class="stat-card stat-card--accent" href="/admin/moderation/ads">
        <div class="stat-number"><%= stats.blockedAds %></div>
        <div class="stat-label">blocked ads</div>
      </a>
    </div>
  </div>
<% } %>

<div class="card card-body d-flex flex-column flex-sm-row align-items-sm-center gap-3">
  <div class="flex-grow-1">
    <div class="fw-bold">Got something to sell?</div>
    <div class="text-muted small">Add a title, price, description and a photo — it takes a minute.</div>
  </div>
  <a class="btn btn-primary rounded-pill px-4" href="/admin/ads/new">Post a new ad</a>
</div>
<%- include('partials/footer') %>

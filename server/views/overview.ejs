<%- include('partials/top') %>
<%
  const tile = (href, number, label, accent) =>
    `<a class="stat-card${accent ? ' stat-card--accent' : ''}" href="${href}"><div class="stat-number">${number}</div><div class="stat-label">${label}</div></a>`;
%>
<div class="mb-4">
  <h1 class="h3 page-title mb-1">Hi, <%= member.username %> 👋</h1>
  <p class="text-muted mb-0">A quick look at your corner of the marketplace.</p>
</div>

<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-4"><%- tile('/admin/listings', numbers.listings, 'listings you posted') %></div>
  <div class="col-sm-6 col-xl-4"><%- tile('/admin/listings', numbers.comments, 'comments under your listings') %></div>
  <div class="col-sm-6 col-xl-4"><%- tile('/admin/saved', numbers.saved, '★ listings you saved', true) %></div>
</div>

<% if (member.role === 'admin') { %>
  <h2 class="side-heading">Whole marketplace</h2>
  <div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><%- tile('/admin/members', numbers.members, 'members', true) %></div>
    <div class="col-6 col-xl-3"><%- tile('/admin/categories', numbers.categories, 'categories', true) %></div>
    <div class="col-6 col-xl-3"><%- tile('/admin/moderation/listings', numbers.allListings, 'listings in total', true) %></div>
    <div class="col-6 col-xl-3"><%- tile('/admin/moderation/comments', numbers.blocked, 'hidden listings + comments', true) %></div>
  </div>
<% } %>

<div class="card card-body d-flex flex-column flex-sm-row align-items-sm-center gap-3">
  <div class="flex-grow-1">
    <div class="fw-bold">Something you no longer need?</div>
    <div class="text-muted small">A title, a price, a few words and a photo — that is all a listing needs.</div>
  </div>
  <a class="btn btn-primary rounded-pill px-4" href="/admin/listings/new">Post a listing</a>
</div>
<%- include('partials/bottom') %>

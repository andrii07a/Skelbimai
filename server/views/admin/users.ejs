<%- include('../partials/header') %>
<h1 class="h3 mb-1">Users</h1>
<p class="text-muted">A blocked user cannot log in, and their ads and comments are hidden from the public site.</p>

<div class="table-responsive bg-white rounded shadow-sm">
  <table class="table mb-0">
    <thead class="table-light">
      <tr><th>Username</th><th>Email</th><th>Role</th><th class="text-end">Ads</th><th>Status</th><th class="text-end">Actions</th></tr>
    </thead>
    <tbody>
      <% for (const u of users) { %>
        <tr class="<%= u.is_blocked ? 'table-danger' : '' %>">
          <td><%= u.username %></td>
          <td><%= u.email %></td>
          <td><span class="badge <%= u.role === 'admin' ? 'text-bg-warning' : 'text-bg-light' %>"><%= u.role %></span></td>
          <td class="text-end"><%= u.ad_count %></td>
          <td><%= u.is_blocked ? 'Blocked' : 'Active' %></td>
          <td class="text-end">
            <% if (u.id === currentUser.id) { %>
              <span class="text-muted small">this is you</span>
            <% } else { %>
              <form method="post" action="/admin/users/<%= u.id %>/toggle-block" class="m-0">
                <button class="btn btn-sm <%= u.is_blocked ? 'btn-success' : 'btn-outline-danger' %>">
                  <%= u.is_blocked ? 'Unblock' : 'Block' %>
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>

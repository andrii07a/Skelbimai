<%- include('partials/top') %>
<div class="mb-3">
  <h1 class="h3 page-title mb-0">★ Saved listings</h1>
  <p class="text-muted mb-0">Everything you starred on the <a href="/">marketplace</a>.</p>
</div>

<% if (rows.length === 0) { %>
  <div class="card card-body text-center py-5">
    <div class="display-6" aria-hidden="true">☆</div>
    <p class="mb-0">Nothing saved yet. Tap the star on any listing to keep it here.</p>
  </div>
<% } else { %>
  <div class="listing-cards">
    <% for (const row of rows) { const gone = row.blocked_at || row.seller_blocked_at; %>
      <article class="listing-card<%= gone ? ' is-blocked' : '' %>">
        <img src="/uploads/<%= row.photo %>" alt="" class="listing-card-photo">
        <div class="listing-card-body">
          <div class="d-flex justify-content-between gap-2">
            <% if (gone) { %>
              <span class="listing-card-title"><%= row.title %></span>
            <% } else { %>
              <a class="listing-card-title" href="/item/<%= row.id %>" target="_blank"><%= row.title %></a>
            <% } %>
            <strong class="text-nowrap"><%= euro(row.price_cents) %> €</strong>
          </div>
          <div class="small text-muted mb-2"><%= row.category_title %> · sold by <%= row.seller %> · saved <%= row.saved_at.slice(0, 10) %></div>
          <% if (gone) { %><div class="status-pill status-pill--hidden">No longer available</div><% } %>
          <div class="listing-card-actions">
            <form method="post" action="/admin/saved/<%= row.id %>/remove" class="d-inline">
              <button class="btn btn-sm btn-outline-secondary">☆ Remove from saved</button>
            </form>
          </div>
        </div>
      </article>
    <% } %>
  </div>
<% } %>
<%- include('partials/bottom') %>
